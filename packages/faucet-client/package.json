{
  "name": "@midnightntwrk/faucet-client",
  "version": "1.0.0",
  "description": "Midnight faucet library",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/midnightntwrk/midnight-faucet-api.git"
  },
  "author": "IOHK",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint --max-warnings=0",
    "build": "tsc -b ./tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "yarn build",
    "do-publish": "yarn npm publish"
  },
  "files": [
    "dist/"
  ],
  "devDependencies": {
    "eslint": "10.9.1",
    "fast-check": "4.9.0",
    "testcontainers": "12.1.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@midnightntwrk/faucet-internal-api": "workspace:^",
    "luxon": "^3.4.3"
  },
  "peerDependencies": {
    "fp-ts": "^2.16.0",
    "io-ts": "^2.2.20",
    "rxjs": "^7.5.5"
  }
}
