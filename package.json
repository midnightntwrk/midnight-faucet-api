    "migrate-db": "turbo run migrate-db --filter=@midnightntwrk/faucet-server",
    "update-version": "node -e \"const v=process.argv[1];if(!v){console.error('Usage: yarn update-version <version>');process.exit(1)}const {execSync}=require('child_process');execSync(\\`git ls-files '*package.json' | xargs sed -i '' 's/\\\"version\\\": \\\"[^\\\"]*\\\"/\\\"version\\\": \\\"\\${v}\\\"/g'\\`);console.log('✓ Updated all package.json files to version '+v)\" --"
