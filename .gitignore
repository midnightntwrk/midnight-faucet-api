# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.js
package-lock.json
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
logs
.yarnrc.yml

# dist
dist/

# testing
coverage*
reports/
*.cpuprofile
*.v8log.json

# next.js
.next/
out/
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# local env files
# Catch-all rather than an enumeration: per-network files like .env.preprod
# hold real credentials and were slipping past the explicit list, so anything
# .env* is ignored unless whitelisted below.
.env*
!.env.example
!.envrc
config.json5
config.*.json5

# turbo
.turbo
turbo_cache

# vercel
.vercel

# TS
ts-dist
*.tsbuildinfo
/tests/.yarn/*
!/tests/.yarn/plugins
!/tests/.yarn/releases

temp
.direnv
.claude
.claude/
