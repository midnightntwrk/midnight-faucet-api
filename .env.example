# Docker Compose environment variables
# Copy this file to .env and fill in the values

# Faucet keys (required, hex). ENCRYPTION_KEY must be 32 bytes (64 hex chars) for chacha20-poly1305.
ENCRYPTION_KEY=ae18ad906ec2686f7cd8e3b9e97255f4d048225771c0412e82717256dc27c49a
JWT_SIGN_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Postgres
POSTGRES_USER=faucet
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_DB=faucet

# Indexer
INDEXER_STORAGE_PASSWORD=indexer
INDEXER_PUB_SUB_PASSWORD=indexer
INDEXER_LEDGER_STATE_PASSWORD=indexer
INDEXER_SECRET=303132333435363738393031323334353637383930313233343536373839303132

# Third-party (/v1) API. The key is the credential — empty disables the API.
# Amounts are in the token's smallest denomination and default to DROP_AMOUNT.
THIRD_PARTY_API_KEY=test-api-key-12345
# THIRD_PARTY_NETWORK=midnight_undeployed
# THIRD_PARTY_TOKEN=tNIGHT
# THIRD_PARTY_DEFAULT_AMOUNT=5000000000
# THIRD_PARTY_MAX_AMOUNT=5000000000
# THIRD_PARTY_REQUIRE_ORIGIN=false
TESTCONTAINERS_UID=501
