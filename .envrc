if has nix; then
  use flake
fi

# Load the whole .env into the environment. It's docker-oriented, but the extra
# vars are harmless — the app reads only what it needs (and the docker-only ones
# use different names), and turbo passes everything through, so any config var
# you add to .env works for local runs too. (dotenv_if_exists also watches .env.)
dotenv_if_exists
