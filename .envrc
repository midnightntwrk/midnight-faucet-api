# shellcheck shell=bash
if has nix; then
  use flake
fi

# Load the whole .env into the environment. It's docker-oriented, but the extra
# vars are harmless — the app reads only what it needs (and the docker-only ones
# use different names). (dotenv_if_exists also watches .env.)
#
# Note: turbo no longer forwards every variable. `globalPassThroughEnv` in turbo.json
# lists what reaches a task, so a *new* config var added to .env has to be added there
# too before `turbo run dev` will see it.
dotenv_if_exists
