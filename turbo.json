{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local", ".eslintrc.js"],
  "//": "Enumerated rather than \"*\": passing every variable through handed each task the whole CI secret environment and left turbo unable to key its cache on anything.",
  "globalPassThroughEnv": [
    "CI",
    "ENCRYPTION_KEY",
    "JWT_SIGN_SECRET",
    "NPM_TOKEN",
    "NODE_OPTIONS",
    "NETWORK",
    "DEPLOYMENT",
    "SYNC_CACHE",
    "TURNSTILE_HEADER",
    "THIRD_PARTY_API_KEY",
    "VISITOR_PASSWORD",
    "DISPLAY",
    "DOCKER_HOST",
    "TESTCONTAINERS_*"
  ],
  "tasks": {
    "do-publish": {
      "dependsOn": ["build"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["dist/**"],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.css", "!src/**/*.spec.ts", "tsconfig.json", "tsconfig.build.json"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "tsconfig.json"],
      "outputs": []
    },
    "lint": {
      "inputs": ["src/**/*.ts", "src/**/*.tsx"],
      "dependsOn": ["^build", "typecheck"],
      "cache": true
    },
    "test": {
      "dependsOn": ["build", "typecheck"],
      "outputs": ["reports/**", "coverage/**"],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "vitest.config.json", "tsconfig.json", "tsconfig.test.json", "test-compose.yml"]
    },
    "pull-test-images": {
      "cache": false,
      "inputs": ["test-compose.yml"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "start": {
      "persistent": true,
      "cache": false,
      "dependsOn": ["build"]
    },
    "migrate-db": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "publish": {},
    "check": {
      "dependsOn": ["build", "lint", "test"]
    }
  }
}
